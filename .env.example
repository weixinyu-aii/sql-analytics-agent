# 运行环境
APP_ENV=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:8501

# 本地演示默认使用 SQLite；生产环境改为 PostgreSQL/MySQL。
DATABASE_URL=sqlite:///./data/analytics_demo.db
# PostgreSQL 只读用户示例：
# DATABASE_URL=postgresql+psycopg://analytics:analytics@localhost:5432/analytics
# READONLY_DATABASE_URL=postgresql+psycopg://analytics_ro:analytics_ro@localhost:5432/analytics
AUTO_SEED=true
SEED_SCALE=1.0

# 允许访问的业务表白名单，逗号分隔。
ALLOWED_TABLES=categories,products,users,orders,order_items,sales
SQL_MAX_ROWS=200
SQL_TIMEOUT_SECONDS=10
SQL_MAX_RETRIES=2

# LLM: mock/openai/deepseek/qwen/glm
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TEMPERATURE=0

# 也可以不填写 LLM_API_KEY，由后端读取对应供应商标准环境变量：
# OPENAI_API_KEY / DEEPSEEK_API_KEY / DASHSCOPE_API_KEY / ZHIPUAI_API_KEY

# Streamlit
API_BASE_URL=http://localhost:8000/api/v1
